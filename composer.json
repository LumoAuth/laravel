{
    "name": "lumoauth/laravel",
    "description": "LumoAuth for Laravel: service provider, LumoAuth facade and a permission middleware.",
    "type": "library",
    "license": "MIT",
    "keywords": ["lumoauth", "laravel", "auth", "oauth", "authorization"],
    "homepage": "https://lumoauth.dev",
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "lumoauth/lumoauth": "^1.0"
    },
    "autoload": {
        "psr-4": { "LumoAuth\\Laravel\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["LumoAuth\\Laravel\\LumoAuthServiceProvider"],
            "aliases": { "LumoAuth": "LumoAuth\\Laravel\\Facades\\LumoAuth" }
        }
    },
    "config": { "sort-packages": true }
}
